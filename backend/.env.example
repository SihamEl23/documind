# Copie ce fichier en ".env" puis remplis les valeurs.

# PostgreSQL avec pgvector
#  - En local avec Docker :  postgresql+psycopg://postgres:postgres@localhost:5432/documind
#  - Supabase / Neon : copie l'URL de connexion fournie et remplace "postgresql://" par "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/documind

# Clé secrète pour signer les JWT (mets une longue chaîne aléatoire)
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=remplace-moi-par-une-longue-cle-secrete-aleatoire

# Embeddings : "local" (modèle multilingue gratuit, téléchargé au 1er lancement) ou "fake" (tests)
EMBEDDING_PROVIDER=local

# LLM : "groq" (gratuit, https://console.groq.com), "gemini" (gratuit, https://aistudio.google.com) ou "fake"
LLM_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_API_KEY=

FRONTEND_ORIGIN=http://localhost:5173
